# Copy this file to .env.local and fill in values as needed.
# .env.local is gitignored — never commit real secrets.

# Canonical site URL used in metadata, the sitemap, and OG tags.
# Defaults to the production URL if unset — override for local/staging.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 Measurement ID (G-XXXXXXXXXX). Leave empty to disable.
# Set it for the Production environment in Vercel only, so previews and
# local development never send data. Tracking also requires a production
# build, and changing it needs a redeploy (it is read at build time).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
