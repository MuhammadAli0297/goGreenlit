# Copy this file to .env.local and fill in values as needed.
# .env.local is gitignored — never commit real secrets.

# Canonical site URL used in metadata, the sitemap, and OG tags.
# Defaults to the production URL if unset — override for local/staging.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# GA4 Measurement ID (format G-XXXXXXXXXX), from the GA4 property's
# Admin > Data Streams > Web stream details page. Leave unset locally,
# the analytics tag only renders when this is set, so dev traffic never
# gets sent to the real property. Set as a real env var in Vercel for
# production only.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
